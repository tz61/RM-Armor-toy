{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GDB Manual Debug",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Start OpenOCD",
            "program": "${workspaceFolder}/build/Debug/CUBEMX-ARMOR-TOY-STM32L051.elf",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/Program Files (x86)/Arm/GNU Toolchain mingw-w64-i686-arm-none-eabi/bin/arm-none-eabi-gdb.exe",
            "miDebuggerServerAddress": "localhost:14566",
            "setupCommands": [
                {
                    "description": "Reset and Halt",
                    "text": "monitor reset halt",
                    "ignoreFailures": true
                },
                {
                    "description": "Halt the processor",
                    "text": "monitor halt",
                    "ignoreFailures": true
                }
            ],
            "logging": {
                "engineLogging": true
            }
        }
    ]
}